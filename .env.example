# ─────────────────────────────────────────────────────────
# Cortexa Labs — Cold Email System — Environment Variables
# Copy this file to .env and fill in all values.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=cortexa
POSTGRES_PASSWORD=cortexa_secret
POSTGRES_DB=cortexa_db
DATABASE_URL=postgresql+asyncpg://cortexa:cortexa_secret@postgres:5432/cortexa_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── FastAPI ───────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ENVIRONMENT=development   # development | production

# ── Anthropic (Claude) ────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Hunter.io (Email Enrichment) ─────────────────────────
# Get from: https://hunter.io/api-keys
HUNTER_IO_API_KEY=your_hunter_io_key_here

# ── Google OAuth (Gmail API) ─────────────────────────────
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/
# Enable: Gmail API
# Redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Slack Notifications (VC Reply Alerts) ────────────────
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_CHANNEL=#vc-replies

# ── Notification Emails (Nikshay's personal alert inbox) ──
FOUNDER_EMAIL=nikshay@cortexalabs.io
SENDGRID_API_KEY=SG....   # Optional: for email notifications to founder

# ── Sending Engine Defaults ───────────────────────────────
MAX_SENDS_PER_INBOX_PER_DAY=40
WARMUP_RATIO=0.35
# Business hours for send-time randomization (24h format)
SEND_HOUR_MIN=7
SEND_HOUR_MAX=17
# Jitter between sends (seconds)
JITTER_MIN_SECONDS=60
JITTER_MAX_SECONDS=480

# ── Frontend (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Cortexa Labs Info ─────────────────────────────────────
COMPANY_NAME=Cortexa Labs
COMPANY_ADDRESS=New Delhi, India
UNSUBSCRIBE_BASE_URL=http://localhost:8000/unsubscribe
